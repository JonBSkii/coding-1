# problem #2
# create a function that will compare if a student has honnor roll
# the student should be able to imput 2 pieces of data 
# the first should be their grade and the second should be the number of days they have been absent.
if the students grade is above a 90 and the number of absenses is less than 5, the program should print true, otherwise it should print false.

def honor_roll():
    grade = float(input("Enter your grade: "))
    absences = int(input("Enter the number of days absent: "))

    if grade > 90 and absences < 5:
        print(True)
    else:
        print(False)

honor_roll()  